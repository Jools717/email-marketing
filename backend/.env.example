# ==============================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# ==============================================================
# OPCIÓN A: URL directa (Recomendado para servidores en la nube como Supabase, Neon, Railway o VPS)
# DATABASE_URL=postgresql://usuario:contrasena@servidor:5432/nombre_db?sslmode=require

# OPCIÓN B: Conexión por variables individuales
DB_HOST=localhost
DB_PORT=5432
DB_NAME=email_marketing
DB_USER=postgres
DB_PASS=admin
DB_SSL=false


# URL Base para enlaces de email marketing (URL del Frontend)
BASE_URL=http://localhost:3000

# Frecuencia de envío de correos (pausa en milisegundos entre envíos para evitar SPAM)
SLEEP_MS=2000

# País de campaña por defecto ('colombia' o 'mexico')
CAMPAIGN_COUNTRY=colombia

# ==============================================================
# PROVEEDOR DE CORREO SALIENTE (SMTP o GMAIL)
# ==============================================================
# Opción 1: GMAIL
EMAIL_SERVICE=gmail
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_PASS=tu-contraseña-de-aplicación-gmail
GMAIL_FROM="Tu Nombre B2B <tu-cuenta@gmail.com>"

# Opción 2: Servidor SMTP personalizado (descomentar si EMAIL_SERVICE=smtp)
# EMAIL_SERVICE=smtp
# SMTP_HOST=mail.tu-dominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=contacto@tu-dominio.com
# SMTP_PASS=tu-contraseña-smtp
# SMTP_FROM="Tu Nombre B2B <contacto@tu-dominio.com>"

# ==============================================================
# NOTIFICACIONES POR WHATSAPP (BOT CHABITO / NOTIFY-ENDPOINT)
# ==============================================================
# Activar o desactivar notificaciones
NOTIFY_ENABLED=true

# URL del endpoint de notificación del bot de WhatsApp
NOTIFY_ENDPOINT_URL=https://tu-servidor-o-bot.com/api/notify

# Token administrativo (CHABITO_ADMIN_TOKEN o ADMIN_TOKEN)
CHABITO_ADMIN_TOKEN=tu_token_aqui

# Número de WhatsApp que recibirá las alertas (código de país incluido)
# Ejemplo: +573001234567 o +525512345678
NOTIFY_PHONE=+573001234567

# ==============================================================
# PROGRAMACIÓN AUTOMÁTICA (SCHEDULER / CRON)
# ==============================================================
# Expresión cron para ejecución automática.
# Ejemplos:
# "0 9 * * 1-5"   -> Lunes a Viernes a las 9:00 AM
# "0 8,14 * * 1-5" -> Lunes a Viernes a las 8:00 AM y 2:00 PM
# "0 */3 * * *"   -> Cada 3 horas
# "*/30 * * * *"  -> Cada 30 minutos (para pruebas)
CAMPAIGN_CRON_SCHEDULE="0 9 * * 1-5"

# Zona horaria para el cron (ej. 'America/Bogota', 'America/Mexico_City')
CAMPAIGN_TIMEZONE="America/Bogota"

# Ejecutar una vez inmediatamente al arrancar el scheduler
RUN_ON_STARTUP=false
